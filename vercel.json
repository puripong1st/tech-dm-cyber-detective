{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "*.html",
          "*.js",
          "*.json",
          "*.png",
          "*.jpg",
          "*.jpeg",
          "*.svg",
          "*.ico",
          "*.xml",
          "*.txt",
          "assets/**/*",
          "css/**/*",
          "js/**/*"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "server.js" },
    { "src": "/css/(.*)", "dest": "server.js" },
    { "src": "/js/(.*)", "dest": "server.js" },
    { "src": "/api/(.*)", "dest": "server.js" },
    { "src": "/detective", "dest": "server.js" },
    { "src": "/teacher", "dest": "server.js" },
    { "src": "/presentation", "dest": "server.js" },
    { "src": "/cases", "dest": "server.js" },
    { "src": "/cases_data.js", "dest": "server.js" },
    { "src": "/(.*)", "dest": "server.js" }
  ]
}
