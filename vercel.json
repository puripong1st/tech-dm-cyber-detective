{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server.js" },
    { "src": "/detective", "dest": "cyber_detective.html" },
    { "src": "/teacher", "dest": "teacher_dashboard.html" },
    { "src": "/presentation", "dest": "presentation.html" },
    { "src": "/cases", "dest": "cases_reference.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "server.js" }
  ]
}
